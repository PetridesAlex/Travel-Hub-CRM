{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self)"
        }
      ]
    }
  ],
  "functions": {
    "api/ai/assist.js": {
      "maxDuration": 60
    },
    "api/ai/voice-program.js": {
      "maxDuration": 60
    },
    "api/ai/generate.js": {
      "maxDuration": 60
    },
    "api/ai/extract-template-fields.js": {
      "maxDuration": 60
    },
    "api/ai/compare-hotel-rates.js": {
      "maxDuration": 60
    },
    "api/slack/test.js": {
      "maxDuration": 15
    },
    "api/slack/notify.js": {
      "maxDuration": 15
    },
    "api/slack/payment-reminders.js": {
      "maxDuration": 30
    },
    "api/leads/inbound.js": {
      "maxDuration": 15
    },
    "api/admin.js": {
      "maxDuration": 30
    },
    "api/agency.js": {
      "maxDuration": 30
    },
    "api/forms.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/agency/team",
      "destination": "/api/agency?route=team"
    },
    {
      "source": "/api/agency/integrations",
      "destination": "/api/agency?route=integrations"
    },
    {
      "source": "/api/email/send",
      "destination": "/api/agency?route=email"
    },
    {
      "source": "/api/admin/agencies",
      "destination": "/api/admin?route=agencies"
    },
    {
      "source": "/api/admin/agency",
      "destination": "/api/admin?route=agency"
    },
    {
      "source": "/api/admin/invite",
      "destination": "/api/admin?route=invite"
    },
    {
      "source": "/api/ai/calendar-assist",
      "destination": "/api/ai/assist?route=calendar-assist"
    },
    {
      "source": "/api/ai/extract-flight-fields",
      "destination": "/api/ai/extract-template-fields?category=flight_offer"
    },
    {
      "source": "/api/forms/public",
      "destination": "/api/forms?action=public"
    },
    {
      "source": "/api/forms/:action",
      "destination": "/api/forms?action=:action"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
