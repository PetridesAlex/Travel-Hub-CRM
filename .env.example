# Frontend (Vite) — safe to expose in browser
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only — add to .env for local dev:api, and Vercel env for production
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
SLACK_WEBHOOK_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INTEGRATION_ENCRYPTION_KEY=
# Platform Resend fallback for branded team invites (optional if agency Integrations has Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Honeywell Travel <noreply@yourdomain.com>
APP_URL=https://travel-hub-crm.vercel.app
